# App Configuration
PORT=3000
NODE_ENV=development
DEFAULT_TIMEZONE=Africa/Harare

# Database
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truecut_db
DATABASE_URL=postgresql://change-me:change-me@localhost:5432/truecut_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Paynow / EcoCash Integration (Adapter credentials behind interface)
PAYNOW_INTEGRATION_ID=12345
PAYNOW_INTEGRATION_KEY=sample_key
PAYNOW_RESULT_URL=http://localhost:3000/api/v1/payments/webhook
PAYNOW_RETURN_URL=http://localhost:5173/booking/confirmation

# SMS Gateway (set SMS_PROVIDER=GATEWAYAPI, TWILIO, or AFRICASTALKING for real delivery)
SMS_PROVIDER=MOCK
GATEWAYAPI_TOKEN=
GATEWAYAPI_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
